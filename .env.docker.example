# ═══════════════════════════════════════════════════════════════════════════════
#  ArgoMind — Docker Environment Variables
#  Copy this file to .env then fill in your actual credentials:
#
#      cp .env.docker.example .env
#
#  After editing, run:
#      docker compose up --build
# ═══════════════════════════════════════════════════════════════════════════════

# ── PostgreSQL ─────────────────────────────────────────────────────────────────
# Password for the internal postgres user (db container)
POSTGRES_PASSWORD=postgres

# Host port to expose PostgreSQL on (optional, useful for local DB tools)
DB_PORT=5432

# ── MQTT Broker ────────────────────────────────────────────────────────────────
# Host port to expose the Mosquitto broker on
MQTT_PORT=1883

# ── Backend ────────────────────────────────────────────────────────────────────
BACKEND_PORT=8000

# MQTT settings passed to the backend (broker hostname = service name "mqtt")
MQTT_TOPIC=farm/sensor
MQTT_USERNAME=
MQTT_PASSWORD=

# Alert thresholds
SOIL_MOISTURE_MIN=20.0
SOIL_PH_MIN=5.5
SOIL_PH_MAX=7.5
TEMPERATURE_MAX=38.0
HUMIDITY_MIN=30.0

# ── Google Gemini (LangChain RAG + LLM) ───────────────────────────────────────
# Get a free key at: https://aistudio.google.com/app/apikey
GOOGLE_API_KEY=AIza_REPLACE_ME

# Optional — Gemini model name (default: gemini-1.5-flash)
LANGCHAIN_MODEL=gemini-1.5-flash

# Optional — LLM creativity 0.0 (deterministic) to 1.0 (creative)
LANGCHAIN_TEMPERATURE=0.3

# ── OpenWeatherMap ─────────────────────────────────────────────────────────────
# Get a free key at: https://openweathermap.org/api
OPENWEATHER_API_KEY=YOUR_OPENWEATHER_KEY_HERE

# ── Frontend ───────────────────────────────────────────────────────────────────
FRONTEND_PORT=3000

# URL the browser uses to reach the backend API.
# • Localhost / single machine: keep as-is
# • Remote server: change to http://YOUR_SERVER_IP:8000
NEXT_PUBLIC_API_BASE_URL=http://localhost:8000

# ── App (backend) ──────────────────────────────────────────────────────────────
APP_HOST=0.0.0.0
APP_PORT=8000
DEBUG=false
