// =============================================================================
//  AgriMind – Prisma Schema
//  Database: PostgreSQL 16
// =============================================================================

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// ── Farmer / operator account ─────────────────────────────────────────────────
model User {
  id        String   @id @default(cuid())
  email     String   @unique
  name      String
  role      Role     @default(FARMER)
  createdAt DateTime @default(now())
  devices   Device[]
}

enum Role {
  FARMER
  ADMIN
}

// ── IoT field device (ESP32 node) ─────────────────────────────────────────────
model Device {
  id           String         @id @default(cuid())
  name         String
  location     String
  cropType     String
  growthStage  String         @default("vegetative")
  ownerId      String
  owner        User           @relation(fields: [ownerId], references: [id])
  createdAt    DateTime       @default(now())
  lastSeenAt   DateTime?
  readings     SensorReading[]
  forecasts    MlForecast[]
  insights     AiInsight[]
}

// ── Raw sensor reading from ESP32 ─────────────────────────────────────────────
model SensorReading {
  id               String   @id @default(cuid())
  deviceId         String
  device           Device   @relation(fields: [deviceId], references: [id])
  timestamp        DateTime @default(now())
  soilMoisture     Float    // 0–100 %
  soilTemperature  Float    // °C
  airTemperature   Float    // °C
  airHumidity      Float    // 0–100 %

  @@index([deviceId, timestamp])
}

// ── ML forecast record ────────────────────────────────────────────────────────
model MlForecast {
  id                  String   @id @default(cuid())
  deviceId            String
  device              Device   @relation(fields: [deviceId], references: [id])
  generatedAt         DateTime @default(now())
  droughtStressLevel  Int      // 0=healthy 1=watch 2=alert 3=critical
  droughtStressLabel  String
  // Stored as JSON array: [{hoursAhead, soilMoisture, confidence}]
  predictions         Json

  @@index([deviceId, generatedAt])
}

// ── LLM-generated insight ─────────────────────────────────────────────────────
model AiInsight {
  id             String   @id @default(cuid())
  deviceId       String
  device         Device   @relation(fields: [deviceId], references: [id])
  generatedAt    DateTime @default(now())
  statusSummary  String
  actions        Json     // String[]
  riskIfNoAction String
  language       String   @default("id")
  modelId        String   // watsonx model used

  @@index([deviceId, generatedAt])
}
