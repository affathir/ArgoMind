# ── Database ───────────────────────────────────────────────────────────────────
DATABASE_URL=postgresql+psycopg2://postgres:postgres@localhost:5432/argomind

# ── MQTT Broker ────────────────────────────────────────────────────────────────
MQTT_BROKER=localhost
MQTT_PORT=1883
MQTT_TOPIC=farm/sensor
MQTT_USERNAME=
MQTT_PASSWORD=

# ── OpenWeatherMap ─────────────────────────────────────────────────────────────
OPENWEATHER_API_KEY=your_openweathermap_api_key_here

# ── Telegram Bot ───────────────────────────────────────────────────────────────
TELEGRAM_BOT_TOKEN=your_telegram_bot_token_here

# ── Langflow (RAG + LLM) ───────────────────────────────────────────────────────
# 1. Jalankan Langflow: pip install langflow && langflow run
# 2. Import flow: Langflow UI -> Import -> argomind_langflow_flow.json
# 3. Upload KB : node "File" -> upload farming_knowledge_base.txt
# 4. Copy Flow ID dari URL browser (uuid setelah /flow/)
LANGFLOW_API_URL=http://localhost:7860
LANGFLOW_FLOW_ID=
LANGFLOW_API_KEY=

# ── Sensor Alert Thresholds ────────────────────────────────────────────────────
SOIL_MOISTURE_MIN=20.0
SOIL_PH_MIN=5.5
SOIL_PH_MAX=7.5
TEMPERATURE_MAX=38.0
HUMIDITY_MIN=30.0

# ── App ────────────────────────────────────────────────────────────────────────
APP_HOST=0.0.0.0
APP_PORT=8000
DEBUG=false
