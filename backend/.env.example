# ── Database ───────────────────────────────────────────────────────────────────
DATABASE_URL=postgresql+psycopg2://postgres:postgres@localhost:5432/argomind

# ── MQTT Broker ────────────────────────────────────────────────────────────────
MQTT_BROKER=localhost
MQTT_PORT=1883
MQTT_TOPIC=farm/sensor
MQTT_USERNAME=
MQTT_PASSWORD=

# ── OpenWeatherMap ─────────────────────────────────────────────────────────────
OPENWEATHER_API_KEY=your_openweathermap_api_key_here

# ── Telegram Bot ───────────────────────────────────────────────────────────────
TELEGRAM_BOT_TOKEN=your_telegram_bot_token_here

# ── Google Gemini (LangChain RAG + LLM) ───────────────────────────────────────
# Dapatkan API key gratis dari: https://aistudio.google.com/app/apikey
GOOGLE_API_KEY=AIza...

# Model Gemini yang digunakan (opsional, default: gemini-1.5-flash)
LANGCHAIN_MODEL=gemini-1.5-flash

# Temperatur LLM: 0.0 (deterministik) sampai 1.0 (kreatif) — default: 0.3
LANGCHAIN_TEMPERATURE=0.3

# ── Sensor Alert Thresholds ────────────────────────────────────────────────────
SOIL_MOISTURE_MIN=20.0
SOIL_PH_MIN=5.5
SOIL_PH_MAX=7.5
TEMPERATURE_MAX=38.0
HUMIDITY_MIN=30.0

# ── App ────────────────────────────────────────────────────────────────────────
APP_HOST=0.0.0.0
APP_PORT=8000
DEBUG=false
