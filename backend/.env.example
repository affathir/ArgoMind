# ── Database ───────────────────────────────────────────────────────────────────
DATABASE_URL=postgresql+psycopg2://postgres:postgres@localhost:5432/argomind

# ── MQTT Broker ────────────────────────────────────────────────────────────────
MQTT_BROKER=localhost
MQTT_PORT=1883
MQTT_TOPIC=farm/sensor
MQTT_USERNAME=
MQTT_PASSWORD=

# ── OpenWeatherMap ─────────────────────────────────────────────────────────────
OPENWEATHER_API_KEY=your_openweathermap_api_key_here

# ── Telegram Bot ───────────────────────────────────────────────────────────────
TELEGRAM_BOT_TOKEN=your_telegram_bot_token_here

# ── Google Gemini (LLM + Embedding untuk Langflow) ─────────────────────────────
# Dapatkan API key gratis dari: https://aistudio.google.com/app/apikey
GOOGLE_API_KEY=AIza...

# ── Langflow (RAG + LLM pipeline) ──────────────────────────────────────────────
# 1. Install & jalankan : pip install langflow && langflow run
# 2. Import flow         : Langflow UI -> My Flows -> Import -> argomind_langflow_flow.json
# 3. Upload knowledge base: node "File" -> upload farming_knowledge_base.txt
# 4. Isi Google API Key  : di node "Google Generative AI Embeddings" & "Google Generative AI"
# 5. Copy Flow ID        : dari URL browser setelah import (uuid setelah /flow/)
LANGFLOW_API_URL=http://localhost:7860
LANGFLOW_FLOW_ID=
LANGFLOW_API_KEY=

# ── Sensor Alert Thresholds ────────────────────────────────────────────────────
SOIL_MOISTURE_MIN=20.0
SOIL_PH_MIN=5.5
SOIL_PH_MAX=7.5
TEMPERATURE_MAX=38.0
HUMIDITY_MIN=30.0

# ── App ────────────────────────────────────────────────────────────────────────
APP_HOST=0.0.0.0
APP_PORT=8000
DEBUG=false
